# Ambiente: development, test ou production
APP_ENV=development
# Porta HTTP da API
PORT=8000
# String de conexão do MongoDB (obrigatória)
MONGODB_URI=mongodb://localhost:27017
# Nome do banco (obrigatória)
DATABASE_NAME=kanban_management
# Banco usado nos testes de integração (padrão: <DATABASE_NAME>_test)
TEST_DATABASE_NAME=kanban_management_test
# Segredo do JWT, mínimo 32 caracteres (obrigatória)
JWT_SECRET=troque-por-um-segredo-de-pelo-menos-32-chars
# Validade do token em horas (inteiro > 0)
JWT_EXPIRES_HOURS=24
# Nível de log: debug, info, warn ou error
LOG_LEVEL=info
# Formato do log: text ou json (padrão: text em dev, json em production)
LOG_FORMAT=text
# Tamanho máximo de anexos em MB
ATTACHMENT_MAX_SIZE_MB=10
