# Copie para .env.docker (que fica fora do git) e troque o JWT_SECRET.
# Ambiente: development, test ou production
APP_ENV=development
# Porta dentro do container (o compose publica 8000:8000)
PORT=8000
# MongoDB do docker compose (o host "mongo" é o nome do serviço)
MONGODB_URI=mongodb://mongo:27017
DATABASE_NAME=kanban_management
TEST_DATABASE_NAME=kanban_management_test
# Segredo do JWT, mínimo 32 caracteres. TROQUE antes de usar de verdade.
JWT_SECRET=troque-por-um-segredo-de-pelo-menos-32-chars
JWT_EXPIRES_HOURS=24
LOG_LEVEL=info
LOG_FORMAT=json
ATTACHMENT_MAX_SIZE_MB=10
# Anexos em disco, na pasta do volume "uploads"
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/uploads
# Documentação Swagger em /swagger/index.html (true ou false)
SWAGGER_ENABLED=true
